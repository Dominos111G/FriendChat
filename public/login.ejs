<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="css/login.css">
</head>
<body>
    <%- include('elements/header.ejs') %><br>
    <div class="shadow">
        <h2>Log in to our system</h2>
        <form id="loginForm">
            <label for="username">Username:</label><br>
            <input type="text" id="username" name="username" required><br>
        
            <label for="password">Password:</label><br>
            <input type="password" id="password" name="password" required><br>
            <button type="submit" id="login_button" name="login_button">Sign in</button><br>
        </form>
        
        <h2>Register to our system</h2>
        <form id="registerForm">
            <label for="reg_name">Username:</label><br>
            <input type="text" id="reg_name" name="reg_name" required><br>

            <label for="reg_email">Email:</label><br>
            <input type="email" name="reg_email" id="reg_email" required><br>

            <label for="reg_password">Password:</label><br>
            <input type="password" id="reg_password" name="reg_password" required><br>

            <label for="reg_confirmPassword">Confirm password:</label><br>
            <input type="password" id="reg_confirmPassword" name="reg_confirmPassword" required><br>

            <label for="reg_age">Birth date:</label><br>
            <input type="date" id="reg_age" name="reg_age" min="1900-01-01" max="2026-12-31" required><br>
            <button type="submit" id="reg_button" name="reg_button">Sign up</button>
        </form>
    </div>
    <%- include('elements/footer.ejs') %>
    <script>
        async function login_backend() {
            const url = '/api/user/login';
            const data = {
                username: document.getElementById('username').value,
                password: document.getElementById('password').value
            };

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.message || `HTTP error! Status: ${response.status}`);
                }

                window.location.assign('/');
            } catch (error) {
                console.error('Error sending action: ', error.message);
                alert(`Error: ${error.message}`);
            } finally {
                document.getElementById('login_button').disabled = false;
            }
        }

        async function reg_backend() {
            const url = '/api/user/register';
            const data = {
                username: document.getElementById('reg_name').value,
                email: document.getElementById('reg_email').value,
                password: document.getElementById('reg_password').value,
                confirmPassword: document.getElementById('reg_confirmPassword').value,
                birthday: document.getElementById('reg_age').value
            };

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.message || `HTTP error! Status: ${response.status}`);
                }

                window.location.assign('/verify-account');
                alert('Success: ' + result.message);
            } catch (error) {
                console.error('Error sending action: ', error.message);
                alert(`Error: ${error.message}`);
            } finally {
                document.getElementById('reg_button').disabled = false;
            }
            
            // const today = new Date();
            // today.setFullYear(today.getFullYear() - 18);
            // document.getElementById('reg_age').max =
            // today.toISOString().split('T')[0];
        }

        

        document.getElementById('loginForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.getElementById('login_button').disabled = true;
            login_backend();
        });

        document.getElementById('registerForm').addEventListener('submit', (e) => {
            e.preventDefault();
            document.getElementById('reg_button').disabled = true;
            reg_backend();
        });
    </script>
</body>
</html>
