<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/video.css">
  <title>FriendChat - Video Chat</title>

  <!-- ADSENSE -->
  <meta name="google-adsense-account" content="ca-pub-4659014092307821">
</head>
<body>
  <%- include('../elements/header.ejs') %>
  <main>
    <div class="videos">
      <div class="video">
        <h3>Your Video</h3>
        <video id="localVideo" autoplay muted playsinline></video>
      </div>
      <div class="video">
        <h3>Guest Video</h3>
        <video id="remoteVideo" autoplay muted playsinline></video>
        <!-- <video id="remoteVideo" autoplay controls playsinline></video> -->
      </div>
    </div>
    <p id="videoStatus" role="status" aria-live="polite">Start a chat to connect with someone.</p>
    <button id="StartButton" type="button">New Chat</button>
    <button id="MicrophoneButton" type="button" disabled>Mute microphone</button>
    <button id="CameraButton" type="button" disabled>Turn camera off</button>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script type="module" src="/js/video.js"></script>
  <script src="/js/sounds.js"></script>
  <%- include('../elements/footer.ejs') %>
</body>
</html>
